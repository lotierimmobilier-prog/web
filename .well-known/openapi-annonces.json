{
  "openapi": "3.1.0",
  "info": {
    "title": "Annonces LOTIER Immobilier",
    "version": "2.0.0",
    "description": "Catalogue public, en lecture seule, des biens à vendre et à louer de LOTIER Immobilier (Aude, Gard, Hérault). Fichier régénéré chaque jour ; aucune authentification. Le filtrage se fait côté client ; le serveur MCP du site (/mcp/) propose une recherche par critères.",
    "contact": {
      "email": "contact@lotier-immobilier.com",
      "url": "https://lotier.immo/contact/"
    }
  },
  "servers": [
    {
      "url": "https://lotier.immo"
    }
  ],
  "paths": {
    "/annonces/catalogue.json": {
      "get": {
        "operationId": "listerAnnonces",
        "summary": "Toutes les annonces en ligne, avec leurs faits et leur texte",
        "responses": {
          "200": {
            "description": "Date de mise à jour et liste des annonces",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "maj": {
                      "type": "string",
                      "description": "Date de la dernière relecture des annonces (AAAA-MM-JJ)"
                    },
                    "nombre": {
                      "type": "integer"
                    },
                    "annonces": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Annonce"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Annonce": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Adresse de la fiche sur lotier.immo : c'est elle qu'il faut citer"
          },
          "titre": {
            "type": "string",
            "description": "Titre factuel : type de bien, pièces, surface, commune"
          },
          "titre_agent": {
            "type": "string",
            "description": "Titre saisi par l'agent"
          },
          "resume": {
            "type": "string",
            "description": "Résumé en quelques phrases, construit avec les seuls faits de la fiche"
          },
          "transaction": {
            "type": "string",
            "enum": [
              "vente",
              "location"
            ]
          },
          "type_bien": {
            "type": [
              "string",
              "null"
            ],
            "description": "Appartement, Studio, Maison, Immeuble, Terrain, Local commercial, Bureaux, Fonds de commerce, Parking, Garage"
          },
          "ville": {
            "type": "string"
          },
          "departement": {
            "type": [
              "string",
              "null"
            ],
            "description": "Code du département (11, 30, 34)"
          },
          "departement_nom": {
            "type": [
              "string",
              "null"
            ]
          },
          "secteur": {
            "type": [
              "string",
              "null"
            ]
          },
          "prix": {
            "type": [
              "number",
              "null"
            ],
            "description": "En euros ; par mois pour une location. null : prix sur demande"
          },
          "prix_unite": {
            "type": "string"
          },
          "mentions_prix": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "surface_m2": {
            "type": [
              "number",
              "null"
            ]
          },
          "pieces": {
            "type": [
              "integer",
              "null"
            ]
          },
          "chambres": {
            "type": [
              "integer",
              "null"
            ]
          },
          "salles_eau": {
            "type": [
              "integer",
              "null"
            ]
          },
          "terrain": {
            "type": [
              "string",
              "null"
            ]
          },
          "etage": {
            "type": [
              "string",
              "null"
            ]
          },
          "annee_construction": {
            "type": [
              "string",
              "null"
            ]
          },
          "chauffage": {
            "type": [
              "string",
              "null"
            ]
          },
          "exposition": {
            "type": [
              "string",
              "null"
            ]
          },
          "equipements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dpe": {
            "type": [
              "string",
              "null"
            ],
            "description": "Classe énergie, de A à G"
          },
          "dpe_kwh_m2_an": {
            "type": [
              "number",
              "null"
            ]
          },
          "ges": {
            "type": [
              "string",
              "null"
            ],
            "description": "Classe climat, de A à G"
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "agent": {
            "type": [
              "string",
              "null"
            ]
          },
          "telephone_agent": {
            "type": [
              "string",
              "null"
            ]
          },
          "photo": {
            "type": [
              "string",
              "null"
            ]
          },
          "nombre_photos": {
            "type": "integer"
          },
          "description": {
            "type": "string",
            "description": "Texte de l'annonce, sans balises"
          },
          "caracteristiques": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "date_publication": {
            "type": [
              "string",
              "null"
            ],
            "description": "AAAA-MM-JJ ; null si l'annonce est antérieure au suivi des dates"
          },
          "date_mise_a_jour": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
